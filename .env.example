# GO Parauapebas - Variáveis de Ambiente
# Obtenha estas chaves no painel do seu projeto no Supabase:
# Acesse: https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Opcional (para scripts administrativos backend / seed direto via service role)
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Conexão direta PostgreSQL (opcional para migrations via CLI ou Prisma)
DATABASE_URL=postgresql://postgres:[SUA-SENHA]@db.[SEU-PROJETO].supabase.co:5432/postgres
